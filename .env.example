# Telegram bot that delivers order requests to Galyna's phone.
# 1) Create a bot with @BotFather -> copy the token
# 2) Galyna writes /start to the bot, then open
#    https://api.telegram.org/bot<TOKEN>/getUpdates and copy "chat":{"id":...}
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Public site URL (used for canonical / Open Graph)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Sanity CMS (Studio at /studio). Without PROJECT_ID the site uses demo content.
NEXT_PUBLIC_SANITY_PROJECT_ID=
NEXT_PUBLIC_SANITY_DATASET=production
# any long random string; the same value goes into the Sanity webhook
SANITY_REVALIDATE_SECRET=

# 1 = hide the whole site from search engines (temporary domain before launch). Remove at launch.
SITE_NOINDEX=
