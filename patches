Subject: [PATCH] Studio: remove Vision tool

Developer-only GROQ playground, not needed by Galyna; its lazy chunk
crashed in dev (ChunkLoadError). Also drops the @sanity/vision dependency.
---
 package.json     | 1 -
 sanity.config.ts | 4 +---
 2 files changed, 1 insertion(+), 4 deletions(-)

diff --git a/package.json b/package.json
index d79f7b0..9372846 100644
--- a/package.json
+++ b/package.json
@@ -15,7 +15,6 @@
   },
   "dependencies": {
     "@sanity/locale-uk-ua": "^1.0.0",
-    "@sanity/vision": "^4.0.0",
     "next": "^15.5.0",
     "next-sanity": "^10.0.0",
     "react": "^19.1.0",
diff --git a/sanity.config.ts b/sanity.config.ts
index a114902..da13e94 100644
--- a/sanity.config.ts
+++ b/sanity.config.ts
@@ -6,11 +6,10 @@
  */
 import { defineConfig } from "sanity";
 import { structureTool } from "sanity/structure";
-import { visionTool } from "@sanity/vision";
 import { ukUALocale } from "@sanity/locale-uk-ua";
 import { schemaTypes } from "./src/sanity/schemaTypes";
 import { structure } from "./src/sanity/structure";
-import { apiVersion, dataset, projectId } from "./src/sanity/env";
+import { dataset, projectId } from "./src/sanity/env";
 
 const SINGLETONS = new Set(["support", "homePage"]);
 const SINGLETON_ACTIONS = new Set(["publish", "discardChanges", "restore"]);
@@ -24,7 +23,6 @@ export default defineConfig({
   plugins: [
     structureTool({ structure }),
     ukUALocale(), // Studio interface in Ukrainian
-    ...(process.env.NODE_ENV === "development" ? [visionTool({ defaultApiVersion: apiVersion })] : []),
   ],
   schema: {
     types: schemaTypes,
